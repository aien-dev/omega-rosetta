note Rosetta Code task "Determine if a string has all the same characters": https://rosettacode.org/wiki/Determine_if_a_string_has_all_the_same_characters
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
om2
text nl "\n"
text lq "<<<"
text rq ">>>"
text tlen " length "
text tsame ": all the same\n"
text tdiff ": first different '"
text tat "' at "
text u0 "   "
text u1 "2"
text u2 "333"
text u3 ".55"
text u4 "tttTTT"
text u5 "4444 444k"
note emit writes every byte of a to stdout; a short write is retried, an error exits 1
fn emit a view uchar * to void
o = ulong 0
while lt o len a bound 4096
k = write 1 a o sub len a o
if le k 0
exit 1
end
o = add o ulong k
end
end
note emitu writes n in decimal; 20 digits hold every ulong
fn emitu n ulong to void
d = new uchar 20 0
i = ulong 20
v = n
while true bound 20
i = sub i 1
put d i uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
emit part d i sub 20 i
end
note emitc writes one byte
fn emitc c uchar to void
b = new uchar 1 0
put b 0 c
emit b
end
fn show a view uchar * to void
emit lq
emit a
emit rq
emit tlen
emitu len a
for i ulong len a
if ne get a i get a 0
emit tdiff
emitc get a i
emit tat
emitu i
emit nl
ret
end
end
emit tsame
end
fn main to int
note the empty string, as a slice of length 0
show part u0 0 0
show u0
show u1
show u2
show u3
show u4
show u5
ret 0
end
