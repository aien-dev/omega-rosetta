note Rosetta Code task "FizzBuzz": https://rosettacode.org/wiki/FizzBuzz
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
om2
text nl "\n"
text fz "Fizz"
text bz "Buzz"
text fb "FizzBuzz"
note emit writes every byte of a to stdout; a short write is retried, an error exits 1
fn emit a view uchar * to void
o = ulong 0
while lt o len a bound 4096
k = write 1 a o sub len a o
if le k 0
exit 1
end
o = add o ulong k
end
end
note emitu writes n in decimal; 20 digits hold every ulong
fn emitu n ulong to void
d = new uchar 20 0
i = ulong 20
v = n
while true bound 20
i = sub i 1
put d i uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
emit part d i sub 20 i
end
fn main to int
for i ulong 100
n = add i 1
if eq rem n 15 0
emit fb
else
if eq rem n 3 0
emit fz
else
if eq rem n 5 0
emit bz
else
emitu n
end
end
end
emit nl
end
ret 0
end
