note Rosetta Code task "Luhn test of credit card numbers": https://rosettacode.org/wiki/Luhn_test_of_credit_card_numbers
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
om2
text nl "\n"
text tv " valid\n"
text ti " invalid\n"
text n1 "49927398716"
text n2 "49927398717"
text n3 "1234567812345678"
text n4 "1234567812345670"
note emit writes every byte of a to stdout; a short write is retried, an error exits 1
fn emit a view uchar * to void
o = ulong 0
while lt o len a bound 4096
k = write 1 a o sub len a o
if le k 0
exit 1
end
o = add o ulong k
end
end
note from the right, odd places add their digit, even places add the digit sum of twice the digit
fn luhn a view uchar * to bool
s = ulong 0
n = len a
for i ulong n
d = ulong sub get a sub sub n 1 i 48
if eq rem i 2 1
d = mul d 2
if gt d 9
d = sub d 9
end
end
s = add s d
end
ret eq rem s 10 0
end
fn show a view uchar * to void
emit a
if luhn a
emit tv
else
emit ti
end
end
fn main to int
show n1
show n2
show n3
show n4
ret 0
end
