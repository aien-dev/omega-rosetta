note Rosetta Code task "99 bottles of beer": https://rosettacode.org/wiki/99_bottles_of_beer
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
om2
text nl "\n"
text nomore "No more"
text b1 " bottle"
text bn " bottles"
text wall " of beer on the wall\n"
text beer " of beer\n"
text take "Take one down, pass it around\n"
note emit writes every byte of a to stdout; a short write is retried, an error exits 1
fn emit a view uchar * to void
o = ulong 0
while lt o len a bound 4096
k = write 1 a o sub len a o
if le k 0
exit 1
end
o = add o ulong k
end
end
note emitu writes n in decimal; 20 digits hold every ulong
fn emitu n ulong to void
d = new uchar 20 0
i = ulong 20
v = n
while true bound 20
i = sub i 1
put d i uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
emit part d i sub 20 i
end
fn bottles n ulong to void
if eq n 0
emit nomore
else
emitu n
end
if eq n 1
emit b1
else
emit bn
end
end
fn main to int
for i ulong 99
n = sub 99 i
bottles n
emit wall
bottles n
emit beer
emit take
bottles sub n 1
emit wall
if lt i 98
emit nl
end
end
ret 0
end
