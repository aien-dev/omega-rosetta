note Rosetta Code task "Pangram checker": https://rosettacode.org/wiki/Pangram_checker
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
om2
text nl "\n"
text tq "\""
text tis "\" is a pangram\n"
text tnot "\" is not a pangram\n"
text p1 "The quick brown fox jumps over the lazy dog"
text p2 "The quick brown fox jumped over the lazy dog"
text p3 "Pack my box with five dozen liquor jugs."
note emit writes every byte of a to stdout; a short write is retried, an error exits 1
fn emit a view uchar * to void
o = ulong 0
while lt o len a bound 4096
k = write 1 a o sub len a o
if le k 0
exit 1
end
o = add o ulong k
end
end
fn pangram a view uchar * to bool
seen = new uchar 26 0
for i ulong len a
c = get a i
if and ge c 65 le c 90
c = add c 32
end
if and ge c 97 le c 122
put seen sub c 97 1
end
end
for j ulong 26
if eq get seen j 0
ret false
end
end
ret true
end
fn show a view uchar * to void
emit tq
emit a
if pangram a
emit tis
else
emit tnot
end
end
fn main to int
show p1
show p2
show p3
ret 0
end
