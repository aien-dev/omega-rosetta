note Rosetta Code task "Perfect numbers": https://rosettacode.org/wiki/Perfect_numbers
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
om2
text nl "\n"
note emit writes every byte of a to stdout; a short write is retried, an error exits 1
fn emit a view uchar * to void
o = ulong 0
while lt o len a bound 4096
k = write 1 a o sub len a o
if le k 0
exit 1
end
o = add o ulong k
end
end
note emitu writes n in decimal; 20 digits hold every ulong
fn emitu n ulong to void
d = new uchar 20 0
i = ulong 20
v = n
while true bound 20
i = sub i 1
put d i uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
emit part d i sub 20 i
end
note sum of proper divisors, pairing d with n / d up to the square root
fn perfect n ulong to bool
if lt n 2
ret false
end
s = ulong 1
d = ulong 2
while le mul d d n bound 1000
if eq rem n d 0
s = add s d
if ne mul d d n
s = add s div n d
end
end
d = add d 1
end
ret eq s n
end
fn main to int
for i ulong 10000
if perfect i
emitu i
emit nl
end
end
ret 0
end
