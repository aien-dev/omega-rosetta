note Rosetta Code task "Power set": https://rosettacode.org/wiki/Power_set
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
om2
text nl "\n"
text sp " "
text minus "-"
text tlb "{"
text trb "}"
text tcomma ", "
text tcount "subsets: "
note emit writes every byte of a to stdout; a short write is retried, an error exits 1
fn emit a view uchar * to void
o = ulong 0
while lt o len a bound 4096
k = write 1 a o sub len a o
if le k 0
exit 1
end
o = add o ulong k
end
end
note emitu writes n in decimal; 20 digits hold every ulong
fn emitu n ulong to void
d = new uchar 20 0
i = ulong 20
v = n
while true bound 20
i = sub i 1
put d i uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
emit part d i sub 20 i
end
note subset m of {1, 2, 3, 4} holds element i+1 when bit i of m is set; the 16 subsets are listed in
note the order of m, which is binary counting
fn subset m ulong to void
emit tlb
first = true
for i ulong 4
if ne and shr m i 1 0
if not first
emit tcomma
end
emitu add i 1
first = false
end
end
emit trb
emit nl
end
fn main to int
for m ulong 16
subset m
end
emit tcount
emitu 16
emit nl
ret 0
end
