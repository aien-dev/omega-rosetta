note Rosetta Code task "N-queens problem": https://rosettacode.org/wiki/N-queens_problem
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
om2
text nl "\n"
text t1 " queens: "
text t2 " solutions\n"
global cols uchar 8
global d1 uchar 15
global d2 uchar 15
note emit writes every byte of a to stdout; a short write is retried, an error exits 1
fn emit a view uchar * to void
o = ulong 0
while lt o len a bound 4096
k = write 1 a o sub len a o
if le k 0
exit 1
end
o = add o ulong k
end
end
note emitu writes n in decimal; 20 digits hold every ulong
fn emitu n ulong to void
d = new uchar 20 0
i = ulong 20
v = n
while true bound 20
i = sub i 1
put d i uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
emit part d i sub 20 i
end
note counts placements for rows r .. n-1; d1 holds the r+c diagonals, d2 the r-c+7 ones
fn place r ulong n ulong to ulong
if eq r n
ret 1
end
cnt = ulong 0
for c ulong n
a = add r c
b = add r sub 7 c
if eq get cols c 0
if eq get d1 a 0
if eq get d2 b 0
put cols c 1
put d1 a 1
put d2 b 1
cnt = add cnt place add r 1 n
put cols c 0
put d1 a 0
put d2 b 0
end
end
end
end
ret cnt
end
fn main to int
for i ulong 8
n = add i 1
emitu n
emit t1
emitu place 0 n
emit t2
end
ret 0
end
