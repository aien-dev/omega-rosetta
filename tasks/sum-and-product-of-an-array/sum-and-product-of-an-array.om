note Rosetta Code task "Sum and product of an array": https://rosettacode.org/wiki/Sum_and_product_of_an_array
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
om2
text nl "\n"
text tsum "sum "
text tprod "product "
note emit writes every byte of a to stdout; a short write is retried, an error exits 1
fn emit a view uchar * to void
o = ulong 0
while lt o len a bound 4096
k = write 1 a o sub len a o
if le k 0
exit 1
end
o = add o ulong k
end
end
note emitu writes n in decimal; 20 digits hold every ulong
fn emitu n ulong to void
d = new uchar 20 0
i = ulong 20
v = n
while true bound 20
i = sub i 1
put d i uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
emit part d i sub 20 i
end
fn main to int
a = new ulong 10 0
for i ulong 10
put a i add i 1
end
s = ulong 0
p = ulong 1
for i ulong 10
s = add s get a i
p = mul p get a i
end
emit tsum
emitu s
emit nl
emit tprod
emitu p
emit nl
ret 0
end
