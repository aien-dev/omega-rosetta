note Rosetta Code task "Abelian sandpile model": https://rosettacode.org/wiki/Abelian_sandpile_model
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
om2
text nl "\n"
text sp " "
text minus "-"
text ttop "topplings: "
global grid ulong 81
global tops ulong 1
note emit writes every byte of a to stdout; a short write is retried, an error exits 1
fn emit a view uchar * to void
o = ulong 0
while lt o len a bound 4096
k = write 1 a o sub len a o
if le k 0
exit 1
end
o = add o ulong k
end
end
note emitu writes n in decimal; 20 digits hold every ulong
fn emitu n ulong to void
d = new uchar 20 0
i = ulong 20
v = n
while true bound 20
i = sub i 1
put d i uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
emit part d i sub 20 i
end
note a cell holding 4 or more grains topples: it loses 4 and each of its 4 neighbours gains 1; grains
note pushed past the edge are lost; the end state and the number of topplings do not depend on order
fn give k ulong r long c long n ulong to void
if and and ge r 0 lt r long n and ge c 0 lt c long n
j = add mul ulong r n ulong c
put grid j add get grid j 1
end
end
fn topple r ulong c ulong n ulong to void
k = add mul r n c
put grid k sub get grid k 4
put tops 0 add get tops 0 1
give k sub long r 1 long c n
give k add long r 1 long c n
give k long r sub long c 1 n
give k long r add long c 1 n
end
note sweep topples every full cell once and says whether any toppled
fn sweep n ulong to bool
any = false
for r ulong n
for c ulong n
if ge get grid add mul r n c 4
topple r c n
any = true
end
end
end
ret any
end
note sweeping in this order takes 6, 25 and 91 sweeps for the three cases (counted on the host);
note 10000 bounds them with room to spare
fn pile n ulong grains ulong to void
for i ulong mul n n
put grid i 0
end
put tops 0 0
m = div n 2
put grid add mul m n m grains
while sweep n bound 10000
end
for r ulong n
for c ulong n
if gt c 0
emit sp
end
emitu get grid add mul r n c
end
emit nl
end
emit ttop
emitu get tops 0
emit nl
end
fn main to int
pile 5 16
emit nl
pile 7 64
emit nl
pile 9 200
ret 0
end
