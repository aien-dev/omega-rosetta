note Rosetta Code task "Ordered partitions": https://rosettacode.org/wiki/Ordered_partitions
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
om2
text nl "\n"
text sp " "
text minus "-"
text tlp "("
text trp ")"
text tlb "{"
text trb "}"
text tcomma ", "
text tpart "partitions"
global size ulong 4
global owner ulong 8
global nb ulong 1
global nel ulong 1
note emit writes every byte of a to stdout; a short write is retried, an error exits 1
fn emit a view uchar * to void
o = ulong 0
while lt o len a bound 4096
k = write 1 a o sub len a o
if le k 0
exit 1
end
o = add o ulong k
end
end
note emitu writes n in decimal; 20 digits hold every ulong
fn emitu n ulong to void
d = new uchar 20 0
i = ulong 20
v = n
while true bound 20
i = sub i 1
put d i uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
emit part d i sub 20 i
end
note owner[i] is the block holding element i+1 (nb = unassigned); blocks are filled in order, each with
note its elements chosen as a lexicographic combination of what is left, so the output is in order
fn show to void
emit tlp
for b ulong get nb 0
if gt b 0
emit tcomma
end
emit tlb
first = true
for i ulong get nel 0
if eq get owner i b
if not first
emit tcomma
end
emitu add i 1
first = false
end
end
emit trb
end
emit trp
emit nl
end
note fill starts block b, or prints the partition once every block is full
fn fill b ulong to void
if eq b get nb 0
show
ret
end
choose b get size b 0
end
note choose gives block b `need` more elements, each larger than the last one chosen (at index >= from)
fn choose b ulong need ulong from ulong to void
if eq need 0
fill add b 1
ret
end
n = get nel 0
for x ulong sub n from
i = add from x
if eq get owner i get nb 0
put owner i b
choose b sub need 1 add i 1
put owner i get nb 0
end
end
end
fn run s0 ulong s1 ulong s2 ulong to void
put nb 0 3
put size 0 s0
put size 1 s1
put size 2 s2
put nel 0 add add s0 s1 s2
for i ulong get nel 0
put owner i 3
end
emit tpart
emit tlp
emitu s0
emit tcomma
emitu s1
emit tcomma
emitu s2
emit trp
emit nl
fill 0
end
fn main to int
run 2 0 2
run 1 2 1
ret 0
end
