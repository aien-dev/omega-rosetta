note Rosetta Code task "Hamming numbers": https://rosettacode.org/wiki/Hamming_numbers
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
om2
text nl "\n"
text sp " "
text minus "-"
text tfirst "first 20: "
text tnth "1691st: "
global ham ulong 1691
note emit writes every byte of a to stdout; a short write is retried, an error exits 1
fn emit a view uchar * to void
o = ulong 0
while lt o len a bound 4096
k = write 1 a o sub len a o
if le k 0
exit 1
end
o = add o ulong k
end
end
note emitu writes n in decimal; 20 digits hold every ulong
fn emitu n ulong to void
d = new uchar 20 0
i = ulong 20
v = n
while true bound 20
i = sub i 1
put d i uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
emit part d i sub 20 i
end
note Dijkstra's method: three indices into the list already built point at the smallest numbers whose
note double, triple and quintuple are not yet listed; the next number is the least of the three
fn min3 a ulong b ulong c ulong to ulong
m = a
if lt b m
m = b
end
if lt c m
m = c
end
ret m
end
fn build n ulong to void
put ham 0 1
i = ulong 0
j = ulong 0
k = ulong 0
for x ulong sub n 1
a = mul get ham i 2
b = mul get ham j 3
c = mul get ham k 5
m = min3 a b c
put ham add x 1 m
if eq a m
i = add i 1
end
if eq b m
j = add j 1
end
if eq c m
k = add k 1
end
end
end
fn main to int
build 1691
emit tfirst
for i ulong 20
if gt i 0
emit sp
end
emitu get ham i
end
emit nl
emit tnth
emitu get ham 1690
emit nl
ret 0
end
