note Rosetta Code task "Almost prime": https://rosettacode.org/wiki/Almost_prime
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
om2
text nl "\n"
text sp " "
text kk "k = "
text col ":"
note emit writes every byte of a to stdout; a short write is retried, an error exits 1
fn emit a view uchar * to void
o = ulong 0
while lt o len a bound 4096
k = write 1 a o sub len a o
if le k 0
exit 1
end
o = add o ulong k
end
end
note emitu writes n in decimal; 20 digits hold every ulong
fn emitu n ulong to void
d = new uchar 20 0
i = ulong 20
v = n
while true bound 20
i = sub i 1
put d i uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
emit part d i sub 20 i
end
note a k-almost prime has exactly k prime factors counted with multiplicity
fn bigo n ulong to ulong
v = n
d = ulong 2
k = ulong 0
while le mul d d v bound 64
if eq rem v d 0
k = add k 1
v = div v d
else
d = add d 1
end
end
if gt v 1
k = add k 1
end
ret k
end
note bound: the 10th 5-almost prime is 176, so no list needs more than 200 candidates
fn main to int
for j ulong 5
k = add j 1
emit kk
emitu k
emit col
c = ulong 0
n = ulong 2
while lt c 10 bound 200
if eq bigo n k
emit sp
emitu n
c = add c 1
end
n = add n 1
end
emit nl
end
ret 0
end
