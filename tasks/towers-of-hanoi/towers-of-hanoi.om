note Rosetta Code task "Towers of Hanoi": https://rosettacode.org/wiki/Towers_of_Hanoi
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
om2
text nl "\n"
text t1 "Move disk "
text t2 " from pole "
text t3 " to pole "
note emit writes every byte of a to stdout; a short write is retried, an error exits 1
fn emit a view uchar * to void
o = ulong 0
while lt o len a bound 4096
k = write 1 a o sub len a o
if le k 0
exit 1
end
o = add o ulong k
end
end
note emitu writes n in decimal; 20 digits hold every ulong
fn emitu n ulong to void
d = new uchar 20 0
i = ulong 20
v = n
while true bound 20
i = sub i 1
put d i uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
emit part d i sub 20 i
end
fn hanoi n ulong src ulong dst ulong via ulong to void
if eq n 0
ret
end
hanoi sub n 1 src via dst
emit t1
emitu n
emit t2
emitu src
emit t3
emitu dst
emit nl
hanoi sub n 1 via dst src
end
fn main to int
hanoi 4 1 3 2
ret 0
end
