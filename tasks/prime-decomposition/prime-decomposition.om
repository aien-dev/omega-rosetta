note Rosetta Code task "Prime decomposition": https://rosettacode.org/wiki/Prime_decomposition
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
om2
text nl "\n"
text eqs " = "
text times " x "
note emit writes every byte of a to stdout; a short write is retried, an error exits 1
fn emit a view uchar * to void
o = ulong 0
while lt o len a bound 4096
k = write 1 a o sub len a o
if le k 0
exit 1
end
o = add o ulong k
end
end
note emitu writes n in decimal; 20 digits hold every ulong
fn emitu n ulong to void
d = new uchar 20 0
i = ulong 20
v = n
while true bound 20
i = sub i 1
put d i uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
emit part d i sub 20 i
end
note trial division; d stays below 2^32 for these inputs, so mul d d does not wrap
fn factor n ulong to void
emitu n
emit eqs
v = n
d = ulong 2
first = true
while le mul d d v bound 999999
if eq rem v d 0
if not first
emit times
end
first = false
emitu d
v = div v d
else
d = add d 1
end
end
if gt v 1
if not first
emit times
end
emitu v
end
emit nl
end
fn main to int
factor 12
factor 360
factor 97
factor 1001
factor 2147483647
factor 600851475143
factor 18446744073709551615
ret 0
end
