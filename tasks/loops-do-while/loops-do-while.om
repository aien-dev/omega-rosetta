note Rosetta Code task "Loops/Do-while": https://rosettacode.org/wiki/Loops/Do-while
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
om2
text nl "\n"
note emit writes every byte of a to stdout; a short write is retried, an error exits 1
fn emit a view uchar * to void
o = ulong 0
while lt o len a bound 4096
k = write 1 a o sub len a o
if le k 0
exit 1
end
o = add o ulong k
end
end
note emitu writes n in decimal; 20 digits hold every ulong
fn emitu n ulong to void
d = new uchar 20 0
i = ulong 20
v = n
while true bound 20
i = sub i 1
put d i uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
emit part d i sub 20 i
end
note start at 0; add 1 and print, then test: repeat while the value is not a multiple of 6
fn main to int
v = ulong 0
while true bound 100
v = add v 1
emitu v
emit nl
if eq rem v 6 0
break
end
end
ret 0
end
