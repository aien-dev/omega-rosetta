note Rosetta Code task "Factors of an integer": https://rosettacode.org/wiki/Factors_of_an_integer
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
om2
text nl "\n"
text sp " "
text pre "factors of "
text col ":"
note emit writes every byte of a to stdout; a short write is retried, an error exits 1
fn emit a view uchar * to void
o = ulong 0
while lt o len a bound 4096
k = write 1 a o sub len a o
if le k 0
exit 1
end
o = add o ulong k
end
end
note emitu writes n in decimal; 20 digits hold every ulong
fn emitu n ulong to void
d = new uchar 20 0
i = ulong 20
v = n
while true bound 20
i = sub i 1
put d i uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
emit part d i sub 20 i
end
note divisors d with d * d <= n come out ascending; their partners n / d, read back in reverse, finish the list
note bound: the largest n here is 600851475143, so d stays below 775147, and no n has more than 64 small divisors
fn tell n ulong to void
lo = new ulong 64 0
k = ulong 0
d = ulong 1
while le mul d d n bound 999999
if eq rem n d 0
put lo k d
k = add k 1
end
d = add d 1
end
emit pre
emitu n
emit col
for i ulong k
emit sp
emitu get lo i
end
for i ulong k
e = get lo sub sub k 1 i
if ne mul e e n
emit sp
emitu div n e
end
end
emit nl
end
fn main to int
tell 1
tell 45
tell 53
tell 64
tell 720
tell 1000000
tell 600851475143
ret 0
end
