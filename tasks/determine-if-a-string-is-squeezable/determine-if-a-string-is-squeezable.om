note Rosetta Code task "Determine if a string is squeezable": https://rosettacode.org/wiki/Determine_if_a_string_is_squeezable
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
om2
text nl "\n"
text lq "<<<"
text rq ">>>"
text tlen " length "
text tch "squeeze '"
text tq "'\n"
text c0 "\"If I were two-faced, would I be wearing this one?\" --- Abraham Lincoln "
text c1 "..1111111111111111111111111111111111111111111111111111111111111117777888"
text c2 "I never give 'em hell, I just tell the truth, and they think it's hell. "
text c3 "                                                    --- Harry S Truman  "
text chars "-7. -r"
note emit writes every byte of a to stdout; a short write is retried, an error exits 1
fn emit a view uchar * to void
o = ulong 0
while lt o len a bound 4096
k = write 1 a o sub len a o
if le k 0
exit 1
end
o = add o ulong k
end
end
note emitu writes n in decimal; 20 digits hold every ulong
fn emitu n ulong to void
d = new uchar 20 0
i = ulong 20
v = n
while true bound 20
i = sub i 1
put d i uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
emit part d i sub 20 i
end
note emitc writes one byte
fn emitc c uchar to void
b = new uchar 1 0
put b 0 c
emit b
end
fn line a view uchar * to void
emit lq
emit a
emit rq
emit tlen
emitu len a
emit nl
end
note squeeze drops a byte equal to ch when the byte before it is also ch
fn squeeze a view uchar * ch uchar to void
o = new uchar 256 0
n = ulong 0
for i ulong len a
c = get a i
k = true
if and gt i 0 eq c ch
k = ne get a sub i 1 ch
end
if k
put o n c
n = add n 1
end
end
emit tch
emitc ch
emit tq
line a
line part o 0 n
end
fn main to int
squeeze c1 get chars 0
squeeze c1 get chars 1
squeeze c2 get chars 2
squeeze c3 get chars 3
squeeze c3 get chars 4
squeeze c3 get chars 5
ret 0
end
