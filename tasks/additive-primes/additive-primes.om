note Rosetta Code task "Additive primes": https://rosettacode.org/wiki/Additive_primes
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
om2
text nl "\n"
text hdr "additive primes below 500 (prime, and the digit sum is prime):\n"
text cnt "count: "
note emit writes every byte of a to stdout; a short write is retried, an error exits 1
fn emit a view uchar * to void
o = ulong 0
while lt o len a bound 4096
k = write 1 a o sub len a o
if le k 0
exit 1
end
o = add o ulong k
end
end
note emitu writes n in decimal; 20 digits hold every ulong
fn emitu n ulong to void
d = new uchar 20 0
i = ulong 20
v = n
while true bound 20
i = sub i 1
put d i uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
emit part d i sub 20 i
end
note emitw writes n in decimal right-aligned in w columns (w at most 20)
fn emitw n ulong w ulong to void
d = new uchar 20 32
i = ulong 20
v = n
while true bound 20
i = sub i 1
put d i uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
if gt i sub 20 w
i = sub 20 w
end
emit part d i sub 20 i
end
fn isprime n ulong to bool
if lt n 2
ret false
end
d = ulong 2
while le mul d d n bound 32
if eq rem n d 0
ret false
end
d = add d 1
end
ret true
end
fn dsum n ulong to ulong
s = ulong 0
v = n
while gt v 0 bound 4
s = add s rem v 10
v = div v 10
end
ret s
end
fn main to int
emit hdr
c = ulong 0
for n ulong 500
if isprime n
if isprime dsum n
emitw n 4
c = add c 1
if eq rem c 10 0
emit nl
end
end
end
end
emit nl
emit cnt
emitu c
emit nl
ret 0
end
