note Rosetta Code task "Combinations": https://rosettacode.org/wiki/Combinations
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
om2
text nl "\n"
text sp " "
text minus "-"
text tcount "combinations: "
global comb ulong 8
note emit writes every byte of a to stdout; a short write is retried, an error exits 1
fn emit a view uchar * to void
o = ulong 0
while lt o len a bound 4096
k = write 1 a o sub len a o
if le k 0
exit 1
end
o = add o ulong k
end
end
note emitu writes n in decimal; 20 digits hold every ulong
fn emitu n ulong to void
d = new uchar 20 0
i = ulong 20
v = n
while true bound 20
i = sub i 1
put d i uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
emit part d i sub 20 i
end
note nextc steps comb[0..k-1] to the next k-subset of 0..n-1 in lexicographic order: raise the last
note element that can still rise and reset the ones after it; false after the last subset
fn nextc k ulong n ulong to bool
i = k
while gt i 0 bound 8
i = sub i 1
if lt get comb i add sub n k i
put comb i add get comb i 1
for x ulong sub sub k i 1
j = add add i x 1
put comb j add get comb sub j 1 1
end
ret true
end
end
ret false
end
fn show k ulong to void
for i ulong k
if gt i 0
emit sp
end
emitu get comb i
end
emit nl
end
note 5 choose 3 is 10, which bounds the loop
fn main to int
k = ulong 3
for i ulong k
put comb i i
end
c = ulong 1
show k
while nextc k 5 bound 10
show k
c = add c 1
end
emit tcount
emitu c
emit nl
ret 0
end
