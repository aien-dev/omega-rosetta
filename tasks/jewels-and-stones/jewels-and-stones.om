note Rosetta Code task "Jewels and stones": https://rosettacode.org/wiki/Jewels_and_stones
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
om2
text nl "\n"
text sp " "
text s1 "aAAbbbb"
text j1 "aA"
text s2 "ZZ"
text j2 "z"
note emit writes every byte of a to stdout; a short write is retried, an error exits 1
fn emit a view uchar * to void
o = ulong 0
while lt o len a bound 4096
k = write 1 a o sub len a o
if le k 0
exit 1
end
o = add o ulong k
end
end
note emitu writes n in decimal; 20 digits hold every ulong
fn emitu n ulong to void
d = new uchar 20 0
i = ulong 20
v = n
while true bound 20
i = sub i 1
put d i uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
emit part d i sub 20 i
end
note count the stones (bytes of s) that are jewels (occur in j); case matters
fn jewels s view uchar * j view uchar * to ulong
n = ulong 0
for i ulong len s
for k ulong len j
if eq get s i get j k
n = add n 1
break
end
end
end
ret n
end
fn show s view uchar * j view uchar * to void
emit s
emit sp
emit j
emit sp
emitu jewels s j
emit nl
end
fn main to int
show s1 j1
show s2 j2
ret 0
end
