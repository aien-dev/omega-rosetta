note Rosetta Code task "Count occurrences of a substring": https://rosettacode.org/wiki/Count_occurrences_of_a_substring
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
om2
text nl "\n"
text h1 "the three truths"
text n1 "th"
text h2 "ababababab"
text n2 "abab"
note emit writes every byte of a to stdout; a short write is retried, an error exits 1
fn emit a view uchar * to void
o = ulong 0
while lt o len a bound 4096
k = write 1 a o sub len a o
if le k 0
exit 1
end
o = add o ulong k
end
end
note emitu writes n in decimal; 20 digits hold every ulong
fn emitu n ulong to void
d = new uchar 20 0
i = ulong 20
v = n
while true bound 20
i = sub i 1
put d i uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
emit part d i sub 20 i
end
note count scans left to right and skips past each match, so matches never overlap
fn count s view uchar * t view uchar * to ulong
c = ulong 0
i = ulong 0
while le add i len t len s bound 4096
m = true
for j ulong len t
if ne get s add i j get t j
m = false
end
end
if m
c = add c 1
i = add i len t
else
i = add i 1
end
end
ret c
end
fn main to int
emitu count h1 n1
emit nl
emitu count h2 n2
emit nl
ret 0
end
