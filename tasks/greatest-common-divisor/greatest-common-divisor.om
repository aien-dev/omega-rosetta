note Rosetta Code task "Greatest common divisor": https://rosettacode.org/wiki/Greatest_common_divisor
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
om2
text nl "\n"
text pre "gcd("
text cm ", "
text post ") = "
note emit writes every byte of a to stdout; a short write is retried, an error exits 1
fn emit a view uchar * to void
o = ulong 0
while lt o len a bound 4096
k = write 1 a o sub len a o
if le k 0
exit 1
end
o = add o ulong k
end
end
note emitu writes n in decimal; 20 digits hold every ulong
fn emitu n ulong to void
d = new uchar 20 0
i = ulong 20
v = n
while true bound 20
i = sub i 1
put d i uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
emit part d i sub 20 i
end
note Euclid; by Lame's theorem two 64-bit numbers need fewer than 100 steps
fn gcd a ulong b ulong to ulong
x = a
y = b
while ne y 0 bound 100
t = rem x y
x = y
y = t
end
ret x
end
fn show a ulong b ulong to void
emit pre
emitu a
emit cm
emitu b
emit post
emitu gcd a b
emit nl
end
fn main to int
show 1071 1029
show 40902 24140
show 12 18
show 17 5
show 0 5
show 18446744073709551615 6148914691236517205
ret 0
end
