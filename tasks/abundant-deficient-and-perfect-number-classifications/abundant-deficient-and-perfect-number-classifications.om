note Rosetta Code task "Abundant, deficient and perfect number classifications": https://rosettacode.org/wiki/Abundant,_deficient_and_perfect_number_classifications
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
om2
text nl "\n"
text tdef "deficient: "
text tper "perfect:   "
text tabu "abundant:  "
note ds n is the sum of the proper divisors of n, for n up to 20000
global ds ulong 20001
note emit writes every byte of a to stdout; a short write is retried, an error exits 1
fn emit a view uchar * to void
o = ulong 0
while lt o len a bound 4096
k = write 1 a o sub len a o
if le k 0
exit 1
end
o = add o ulong k
end
end
note emitu writes n in decimal; 20 digits hold every ulong
fn emitu n ulong to void
d = new uchar 20 0
i = ulong 20
v = n
while true bound 20
i = sub i 1
put d i uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
emit part d i sub 20 i
end
note each i adds itself to its multiples 2i, 3i, ... up to 20000; fewer than 20000 multiples per i
fn sieve to void
i = ulong 1
while le i 10000 bound 10000
j = mul i 2
while le j 20000 bound 20000
put ds j add get ds j i
j = add j i
end
i = add i 1
end
end
note 1..20000 sorted by comparing each n with the sum of its proper divisors
fn main to int
sieve
d = ulong 0
p = ulong 0
a = ulong 0
for i ulong 20000
n = add i 1
s = get ds n
if lt s n
d = add d 1
end
if eq s n
p = add p 1
end
if gt s n
a = add a 1
end
end
emit tdef
emitu d
emit nl
emit tper
emitu p
emit nl
emit tabu
emitu a
emit nl
ret 0
end
