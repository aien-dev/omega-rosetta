note Rosetta Code task "Fibonacci n-step number sequences": https://rosettacode.org/wiki/Fibonacci_n-step_number_sequences
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
om2
text nl "\n"
text sp " "
text t2 "fibonacci: "
text t3 "tribonacci:"
text t4 "tetranacci:"
text t5 "pentanacci:"
text t6 "hexanacci: "
text t7 "heptanacci:"
text t8 "octonacci: "
text t9 "nonanacci: "
text t10 "decanacci: "
text tl "lucas:     "
note emit writes every byte of a to stdout; a short write is retried, an error exits 1
fn emit a view uchar * to void
o = ulong 0
while lt o len a bound 4096
k = write 1 a o sub len a o
if le k 0
exit 1
end
o = add o ulong k
end
end
note emitu writes n in decimal; 20 digits hold every ulong
fn emitu n ulong to void
d = new uchar 20 0
i = ulong 20
v = n
while true bound 20
i = sub i 1
put d i uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
emit part d i sub 20 i
end
note the n-step sequence starts 1, 1, 2, 4, ..., 2^(n-2) (the n-step seeds) and then each term sums the
note previous n; the Lucas numbers are the 2-step sequence seeded 2, 1. 15 terms, all below 2^15 * 15
fn seq n ulong s0 ulong s1 ulong to void
a = new ulong 15 0
put a 0 s0
put a 1 s1
for i ulong 13
k = add i 2
s = ulong 0
if le k sub n 1
s = shl ulong 1 sub k 1
else
for j ulong n
s = add s get a sub sub k 1 j
end
end
put a k s
end
for i ulong 15
emit sp
emitu get a i
end
emit nl
end
fn main to int
emit t2
seq 2 1 1
emit t3
seq 3 1 1
emit t4
seq 4 1 1
emit t5
seq 5 1 1
emit t6
seq 6 1 1
emit t7
seq 7 1 1
emit t8
seq 8 1 1
emit t9
seq 9 1 1
emit t10
seq 10 1 1
emit tl
seq 2 2 1
ret 0
end
