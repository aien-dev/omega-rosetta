note Rosetta Code task "Sorting algorithms/Pancake sort": https://rosettacode.org/wiki/Sorting_algorithms/Pancake_sort
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
om2
text nl "\n"
text sp " "
text minus "-"
text data "23 -7 61 4 0 38 15 -7 90 2 11"
text tflips "flips: "
global vals long 16
note emit writes every byte of a to stdout; a short write is retried, an error exits 1
fn emit a view uchar * to void
o = ulong 0
while lt o len a bound 4096
k = write 1 a o sub len a o
if le k 0
exit 1
end
o = add o ulong k
end
end
note emitu writes n in decimal; 20 digits hold every ulong
fn emitu n ulong to void
d = new uchar 20 0
i = ulong 20
v = n
while true bound 20
i = sub i 1
put d i uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
emit part d i sub 20 i
end
note emiti writes a signed n; the magnitude is taken as a ulong so the minimum long cannot overflow
fn emiti n long to void
if lt n 0
emit minus
emitu add bitcast ulong not n 1
else
emitu ulong n
end
end
note parse reads the decimal numbers in s (separated by spaces, an optional - sign) into vals and
note returns how many; one pass over s, so the loop is bounded by len s
fn parse s view uchar * to ulong
n = ulong 0
v = long 0
sg = long 1
dig = false
for i ulong len s
c = get s i
if eq c 45
sg = long -1
else
if and ge c 48 le c 57
v = add mul v 10 long sub c 48
dig = true
else
if dig
put vals n mul sg v
n = add n 1
end
v = long 0
sg = long 1
dig = false
end
end
end
if dig
put vals n mul sg v
n = add n 1
end
ret n
end
note show writes vals[0..n-1] separated by spaces, then a newline
fn show n ulong to void
for i ulong n
if gt i 0
emit sp
end
emiti get vals i
end
emit nl
end
note flip reverses vals[0..k-1]; k/2 swaps
fn flip k ulong to void
for i ulong shr k 1
t = get vals i
put vals i get vals sub sub k i 1
put vals sub sub k i 1 t
end
end
note pksort brings the largest of vals[0..s-1] to the front, then flips it to position s-1, for s = n .. 2;
note it returns the number of flips made, at most 2*(n-1)
fn pksort n ulong to ulong
f = ulong 0
for x ulong sub n 1
s = sub n x
m = ulong 0
for i ulong s
if gt get vals i get vals m
m = i
end
end
if ne m sub s 1
if ne m 0
flip add m 1
f = add f 1
end
flip s
f = add f 1
end
end
ret f
end
fn main to int
n = parse data
show n
f = pksort n
show n
emit tflips
emitu f
emit nl
ret 0
end
