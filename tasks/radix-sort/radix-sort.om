note Rosetta Code task "Sorting algorithms/Radix sort": https://rosettacode.org/wiki/Sorting_algorithms/Radix_sort
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
om2
text nl "\n"
text sp " "
text minus "-"
text data "170 45 75 -90 -802 24 2 66 0 1999 -1 333"
global vals long 16
global key ulong 16
global tk ulong 16
global bk ulong 10
note emit writes every byte of a to stdout; a short write is retried, an error exits 1
fn emit a view uchar * to void
o = ulong 0
while lt o len a bound 4096
k = write 1 a o sub len a o
if le k 0
exit 1
end
o = add o ulong k
end
end
note emitu writes n in decimal; 20 digits hold every ulong
fn emitu n ulong to void
d = new uchar 20 0
i = ulong 20
v = n
while true bound 20
i = sub i 1
put d i uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
emit part d i sub 20 i
end
note emiti writes a signed n; the magnitude is taken as a ulong so the minimum long cannot overflow
fn emiti n long to void
if lt n 0
emit minus
emitu add bitcast ulong not n 1
else
emitu ulong n
end
end
note parse reads the decimal numbers in s (separated by spaces, an optional - sign) into vals and
note returns how many; one pass over s, so the loop is bounded by len s
fn parse s view uchar * to ulong
n = ulong 0
v = long 0
sg = long 1
dig = false
for i ulong len s
c = get s i
if eq c 45
sg = long -1
else
if and ge c 48 le c 57
v = add mul v 10 long sub c 48
dig = true
else
if dig
put vals n mul sg v
n = add n 1
end
v = long 0
sg = long 1
dig = false
end
end
end
if dig
put vals n mul sg v
n = add n 1
end
ret n
end
note show writes vals[0..n-1] separated by spaces, then a newline
fn show n ulong to void
for i ulong n
if gt i 0
emit sp
end
emiti get vals i
end
emit nl
end
note rxsort shifts every value by the minimum so the keys are unsigned, then sorts the keys with a
note stable least-significant-digit-first counting pass per decimal digit; 20 passes cover any ulong
fn rxsort n ulong to void
lo = get vals 0
for i ulong n
if lt get vals i lo
lo = get vals i
end
end
mx = ulong 0
for i ulong n
put key i ulong sub get vals i lo
if gt get key i mx
mx = get key i
end
end
e = ulong 1
for p ulong 20
for b ulong 10
put bk b 0
end
for i ulong n
dg = rem div get key i e 10
put bk dg add get bk dg 1
end
s = ulong 0
for b ulong 10
c = get bk b
put bk b s
s = add s c
end
for i ulong n
dg = rem div get key i e 10
put tk get bk dg get key i
put bk dg add get bk dg 1
end
for i ulong n
put key i get tk i
end
note stop when no key has a digit at 10*e; e > mx/10 means 10*e > mx, and 10*e is never formed past that
if gt e div mx 10
break
end
e = mul e 10
end
for i ulong n
put vals i add lo long get key i
end
end
fn main to int
n = parse data
show n
rxsort n
show n
ret 0
end
