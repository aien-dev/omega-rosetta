note Rosetta Code task "Permutations": https://rosettacode.org/wiki/Permutations
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
om2
text nl "\n"
text sp " "
text minus "-"
text tcount "permutations: "
global perm ulong 8
note emit writes every byte of a to stdout; a short write is retried, an error exits 1
fn emit a view uchar * to void
o = ulong 0
while lt o len a bound 4096
k = write 1 a o sub len a o
if le k 0
exit 1
end
o = add o ulong k
end
end
note emitu writes n in decimal; 20 digits hold every ulong
fn emitu n ulong to void
d = new uchar 20 0
i = ulong 20
v = n
while true bound 20
i = sub i 1
put d i uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
emit part d i sub 20 i
end
note nextp steps perm[0..n-1] to the next permutation in lexicographic order; false after the last:
note find the last ascent i-1 < i, swap perm[i-1] with the last larger element, reverse the tail
fn nextp n ulong to bool
i = sub n 1
while gt i 0 bound 8
if lt get perm sub i 1 get perm i
break
end
i = sub i 1
end
if eq i 0
ret false
end
j = sub n 1
while le get perm j get perm sub i 1 bound 8
j = sub j 1
end
t = get perm sub i 1
put perm sub i 1 get perm j
put perm j t
k = sub n 1
while lt i k bound 8
t2 = get perm i
put perm i get perm k
put perm k t2
i = add i 1
k = sub k 1
end
ret true
end
fn show n ulong to void
for i ulong n
if gt i 0
emit sp
end
emitu get perm i
end
emit nl
end
note all 4! orders of 1 2 3 4; 24 permutations bound the loop
fn main to int
n = ulong 4
for i ulong n
put perm i add i 1
end
c = ulong 1
show n
while nextp n bound 24
show n
c = add c 1
end
emit tcount
emitu c
emit nl
ret 0
end
