note Rosetta Code task "Smith numbers": https://rosettacode.org/wiki/Smith_numbers
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
om2
text nl "\n"
text sp " "
text cnt "Smith numbers below 10000: "
text first "first 20:"
text last "last 10:"
note emit writes every byte of a to stdout; a short write is retried, an error exits 1
fn emit a view uchar * to void
o = ulong 0
while lt o len a bound 4096
k = write 1 a o sub len a o
if le k 0
exit 1
end
o = add o ulong k
end
end
note emitu writes n in decimal; 20 digits hold every ulong
fn emitu n ulong to void
d = new uchar 20 0
i = ulong 20
v = n
while true bound 20
i = sub i 1
put d i uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
emit part d i sub 20 i
end
fn dsum n ulong to ulong
s = ulong 0
v = n
while gt v 0 bound 20
s = add s rem v 10
v = div v 10
end
ret s
end
note a Smith number is composite and its digit sum equals the digit sums of its prime factors, with
note multiplicity; returns 0 for primes and 1
fn smith n ulong to bool
v = n
d = ulong 2
f = ulong 0
k = ulong 0
while le mul d d v bound 200
if eq rem v d 0
f = add f dsum d
k = add k 1
v = div v d
else
d = add d 1
end
end
if gt v 1
f = add f dsum v
k = add k 1
end
if lt k 2
ret false
end
ret eq f dsum n
end
fn main to int
sm = new ulong 400 0
c = ulong 0
for i ulong 9998
n = add i 2
if smith n
put sm c n
c = add c 1
end
end
emit cnt
emitu c
emit nl
emit first
for i ulong 20
emit sp
emitu get sm i
end
emit nl
emit last
for i ulong 10
emit sp
emitu get sm add sub c 10 i
end
emit nl
ret 0
end
