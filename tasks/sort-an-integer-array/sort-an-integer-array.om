note Rosetta Code task "Sort an integer array": https://rosettacode.org/wiki/Sort_an_integer_array
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
om2
text nl "\n"
text sp " "
text minus "-"
text data "2 4 3 1 2 -10 37 0 15 -10 8 100 5"
global vals long 16
note emit writes every byte of a to stdout; a short write is retried, an error exits 1
fn emit a view uchar * to void
o = ulong 0
while lt o len a bound 4096
k = write 1 a o sub len a o
if le k 0
exit 1
end
o = add o ulong k
end
end
note emitu writes n in decimal; 20 digits hold every ulong
fn emitu n ulong to void
d = new uchar 20 0
i = ulong 20
v = n
while true bound 20
i = sub i 1
put d i uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
emit part d i sub 20 i
end
note emiti writes a signed n; the magnitude is taken as a ulong so the minimum long cannot overflow
fn emiti n long to void
if lt n 0
emit minus
emitu add bitcast ulong not n 1
else
emitu ulong n
end
end
note parse reads the decimal numbers in s (separated by spaces, an optional - sign) into vals and
note returns how many; one pass over s, so the loop is bounded by len s
fn parse s view uchar * to ulong
n = ulong 0
v = long 0
sg = long 1
dig = false
for i ulong len s
c = get s i
if eq c 45
sg = long -1
else
if and ge c 48 le c 57
v = add mul v 10 long sub c 48
dig = true
else
if dig
put vals n mul sg v
n = add n 1
end
v = long 0
sg = long 1
dig = false
end
end
end
if dig
put vals n mul sg v
n = add n 1
end
ret n
end
note show writes vals[0..n-1] separated by spaces, then a newline
fn show n ulong to void
for i ulong n
if gt i 0
emit sp
end
emiti get vals i
end
emit nl
end
note Omega has no library sort, so this is a binary insertion sort: binary search finds where vals[i]
note goes among the sorted vals[0..i-1] (after equal values, so it is stable), then the tail shifts up;
note the search range halves each pass, so 16 elements need at most 5 passes (bound 8)
fn bisort n ulong to void
for i ulong n
v = get vals i
lo = ulong 0
hi = i
while lt lo hi bound 8
m = add lo shr sub hi lo 1
if le get vals m v
lo = add m 1
else
hi = m
end
end
for x ulong sub i lo
k = sub i x
put vals k get vals sub k 1
end
put vals lo v
end
end
fn main to int
n = parse data
show n
bisort n
show n
ret 0
end
