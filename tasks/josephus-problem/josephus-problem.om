note Rosetta Code task "Josephus problem": https://rosettacode.org/wiki/Josephus_problem
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
om2
text nl "\n"
text sp " "
text minus "-"
text tkill "executed in order:"
text tsurv "survivor: "
global alive uchar 41
note emit writes every byte of a to stdout; a short write is retried, an error exits 1
fn emit a view uchar * to void
o = ulong 0
while lt o len a bound 4096
k = write 1 a o sub len a o
if le k 0
exit 1
end
o = add o ulong k
end
end
note emitu writes n in decimal; 20 digits hold every ulong
fn emitu n ulong to void
d = new uchar 20 0
i = ulong 20
v = n
while true bound 20
i = sub i 1
put d i uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
emit part d i sub 20 i
end
note 41 prisoners numbered 0..40 stand in a circle; counting from 0, every 3rd one still alive is killed
note until one is left; each kill walks at most 3 live places, so 3*41 steps per kill bound the walk
fn main to int
n = ulong 41
k = ulong 3
for i ulong n
put alive i 1
end
p = sub n 1
emit tkill
for x ulong sub n 1
c = ulong 0
while lt c k bound 123
p = rem add p 1 n
if eq get alive p 1
c = add c 1
end
end
put alive p 0
emit sp
emitu p
end
emit nl
emit tsurv
for i ulong n
if eq get alive i 1
emitu i
end
end
emit nl
ret 0
end
