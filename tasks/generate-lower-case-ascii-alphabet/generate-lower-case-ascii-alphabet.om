note Rosetta Code task "Generate lower case ASCII alphabet": https://rosettacode.org/wiki/Generate_lower_case_ASCII_alphabet
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
om2
text nl "\n"
note emit writes every byte of a to stdout; a short write is retried, an error exits 1
fn emit a view uchar * to void
o = ulong 0
while lt o len a bound 4096
k = write 1 a o sub len a o
if le k 0
exit 1
end
o = add o ulong k
end
end
fn main to int
a = new uchar 26 0
for i ulong 26
put a i add uchar i 97
end
emit a
emit nl
ret 0
end
