note Rosetta Code task "Pythagorean triples": https://rosettacode.org/wiki/Pythagorean_triples
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
om2
text nl "\n"
text pre "perimeter <= "
text col ": "
text tr " triples, "
text pr " primitive\n"
note emit writes every byte of a to stdout; a short write is retried, an error exits 1
fn emit a view uchar * to void
o = ulong 0
while lt o len a bound 4096
k = write 1 a o sub len a o
if le k 0
exit 1
end
o = add o ulong k
end
end
note emitu writes n in decimal; 20 digits hold every ulong
fn emitu n ulong to void
d = new uchar 20 0
i = ulong 20
v = n
while true bound 20
i = sub i 1
put d i uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
emit part d i sub 20 i
end
fn gcd a ulong b ulong to ulong
x = a
y = b
while ne y 0 bound 128
t = rem x y
x = y
y = t
end
ret x
end
note Euclid: m > n > 0 coprime of opposite parity give each primitive triple once, with perimeter 2m(m+n);
note a primitive perimeter p counts for limit L once as primitive and L / p times among all triples
note bound: 2m(m+1) <= 10^7 needs m <= 2235
fn main to int
pc = new ulong 7 0
tc = new ulong 7 0
m = ulong 2
while le mul mul 2 m add m 1 10000000 bound 2236
n = add rem m 2 1
while lt n m bound 2236
p = mul mul 2 m add m n
if gt p 10000000
break
end
if eq gcd m n 1
l = ulong 100
for k ulong 6
if le p l
put pc k add get pc k 1
put tc k add get tc k div l p
end
l = mul l 10
end
end
n = add n 2
end
m = add m 1
end
l = ulong 100
for k ulong 6
emit pre
emitu l
emit col
emitu get tc k
emit tr
emitu get pc k
emit pr
l = mul l 10
end
ret 0
end
