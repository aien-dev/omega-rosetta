note Rosetta Code task "Zig-zag matrix": https://rosettacode.org/wiki/Zig-zag_matrix
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
om2
text nl "\n"
text sp " "
text minus "-"
global grid ulong 64
note emit writes every byte of a to stdout; a short write is retried, an error exits 1
fn emit a view uchar * to void
o = ulong 0
while lt o len a bound 4096
k = write 1 a o sub len a o
if le k 0
exit 1
end
o = add o ulong k
end
end
note emitu writes n in decimal; 20 digits hold every ulong
fn emitu n ulong to void
d = new uchar 20 0
i = ulong 20
v = n
while true bound 20
i = sub i 1
put d i uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
emit part d i sub 20 i
end
note emitw writes n right-aligned in w columns (w at most 20; a wider number is not cut)
fn emitw n ulong w ulong to void
d = new uchar 20 32
i = ulong 20
v = n
while true bound 20
i = sub i 1
put d i uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
if gt w sub 20 i
i = sub 20 w
end
emit part d i sub 20 i
end
note number the cells along the anti-diagonals d = i + j; even diagonals run up and to the right
note (i falling), odd ones down and to the left (i rising)
fn zigzag n ulong to void
k = ulong 0
for d ulong sub mul n 2 1
for x ulong add d 1
i = x
if eq rem d 2 0
i = sub d x
end
if and lt i n le sub d i sub n 1
put grid add mul i n sub d i k
k = add k 1
end
end
end
end
fn show n ulong to void
for i ulong n
for j ulong n
emitw get grid add mul i n j 3
end
emit nl
end
end
fn main to int
zigzag 5
show 5
emit nl
zigzag 6
show 6
ret 0
end
