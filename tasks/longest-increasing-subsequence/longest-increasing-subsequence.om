note Rosetta Code task "Longest increasing subsequence": https://rosettacode.org/wiki/Longest_increasing_subsequence
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
om2
text nl "\n"
text sp " "
text minus "-"
text d1 "3 2 6 4 5 1"
text d2 "0 8 4 12 2 10 6 14 1 9 5 13 3 11 7 15"
global vals long 16
global ln ulong 16
global nx ulong 16
note emit writes every byte of a to stdout; a short write is retried, an error exits 1
fn emit a view uchar * to void
o = ulong 0
while lt o len a bound 4096
k = write 1 a o sub len a o
if le k 0
exit 1
end
o = add o ulong k
end
end
note emitu writes n in decimal; 20 digits hold every ulong
fn emitu n ulong to void
d = new uchar 20 0
i = ulong 20
v = n
while true bound 20
i = sub i 1
put d i uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
emit part d i sub 20 i
end
note emiti writes a signed n; the magnitude is taken as a ulong so the minimum long cannot overflow
fn emiti n long to void
if lt n 0
emit minus
emitu add bitcast ulong not n 1
else
emitu ulong n
end
end
note parse reads the decimal numbers in s (separated by spaces, an optional - sign) into vals and
note returns how many; one pass over s, so the loop is bounded by len s
fn parse s view uchar * to ulong
n = ulong 0
v = long 0
sg = long 1
dig = false
for i ulong len s
c = get s i
if eq c 45
sg = long -1
else
if and ge c 48 le c 57
v = add mul v 10 long sub c 48
dig = true
else
if dig
put vals n mul sg v
n = add n 1
end
v = long 0
sg = long 1
dig = false
end
end
end
if dig
put vals n mul sg v
n = add n 1
end
ret n
end
note show writes vals[0..n-1] separated by spaces, then a newline
fn show n ulong to void
for i ulong n
if gt i 0
emit sp
end
emiti get vals i
end
emit nl
end
note lis prints the lexicographically smallest of the longest strictly increasing subsequences:
note ln[i] is the longest increasing run starting at i (computed right to left), nx[i] the smallest
note next value that keeps it longest; the walk then starts at the smallest value with the maximum ln
note grow considers continuing the run at i with element k > i
fn grow i ulong k ulong to void
if gt get vals k get vals i
c = add get ln k 1
if gt c get ln i
put ln i c
put nx i k
else
if eq c get ln i
if lt get vals k get vals get nx i
put nx i k
end
end
end
end
end
note better says whether a run starting at i beats the best so far (length m starting at s)
fn better i ulong s ulong m ulong to bool
if gt get ln i m
ret true
end
ret and eq get ln i m lt get vals i get vals s
end
fn lis n ulong to void
for x ulong n
i = sub sub n x 1
put ln i 1
put nx i n
for j ulong sub sub n i 1
grow i add add i j 1
end
end
m = ulong 0
s = ulong 0
for i ulong n
if better i s m
m = get ln i
s = i
end
end
i = s
for x ulong m
if gt x 0
emit sp
end
emiti get vals i
i = get nx i
end
emit nl
end
fn main to int
n = parse d1
show n
lis n
n = parse d2
show n
lis n
ret 0
end
