note Rosetta Code task "Attractive numbers": https://rosettacode.org/wiki/Attractive_numbers
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
om2
text nl "\n"
text hdr "attractive numbers up to 120 (the count of prime factors, with multiplicity, is prime):\n"
note emit writes every byte of a to stdout; a short write is retried, an error exits 1
fn emit a view uchar * to void
o = ulong 0
while lt o len a bound 4096
k = write 1 a o sub len a o
if le k 0
exit 1
end
o = add o ulong k
end
end
note emitu writes n in decimal; 20 digits hold every ulong
fn emitu n ulong to void
d = new uchar 20 0
i = ulong 20
v = n
while true bound 20
i = sub i 1
put d i uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
emit part d i sub 20 i
end
note emitw writes n in decimal right-aligned in w columns (w at most 20)
fn emitw n ulong w ulong to void
d = new uchar 20 32
i = ulong 20
v = n
while true bound 20
i = sub i 1
put d i uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
if gt i sub 20 w
i = sub 20 w
end
emit part d i sub 20 i
end
note Omega(n): the number of prime factors of n counted with multiplicity
fn bigo n ulong to ulong
v = n
d = ulong 2
k = ulong 0
while le mul d d v bound 64
if eq rem v d 0
k = add k 1
v = div v d
else
d = add d 1
end
end
if gt v 1
k = add k 1
end
ret k
end
note Omega(n) <= 6 for n <= 120, so the primes to test are 2, 3 and 5
fn main to int
emit hdr
c = ulong 0
for i ulong 120
n = add i 1
k = bigo n
if or or eq k 2 eq k 3 eq k 5
emitw n 4
c = add c 1
if eq rem c 20 0
emit nl
end
end
end
emit nl
ret 0
end
