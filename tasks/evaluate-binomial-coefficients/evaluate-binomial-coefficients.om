note Rosetta Code task "Evaluate binomial coefficients": https://rosettacode.org/wiki/Evaluate_binomial_coefficients
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
om2
text nl "\n"
text cc "C("
text cm ", "
text eqs ") = "
note emit writes every byte of a to stdout; a short write is retried, an error exits 1
fn emit a view uchar * to void
o = ulong 0
while lt o len a bound 4096
k = write 1 a o sub len a o
if le k 0
exit 1
end
o = add o ulong k
end
end
note emitu writes n in decimal; 20 digits hold every ulong
fn emitu n ulong to void
d = new uchar 20 0
i = ulong 20
v = n
while true bound 20
i = sub i 1
put d i uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
emit part d i sub 20 i
end
fn gcd a ulong b ulong to ulong
x = a
y = b
while ne y 0 bound 128
t = rem x y
x = y
y = t
end
ret x
end
note r runs through C(n-k+i, i) for i = 1..k; with g = gcd(r, i), i / g divides n - k + i, so
note r / g * ((n-k+i) / (i / g)) is exact and never exceeds the final value, which must fit 64 bits
fn binom n ulong k ulong to ulong
r = ulong 1
for j ulong k
i = add j 1
g = gcd r i
r = mul div r g div add sub n k i div i g
end
ret r
end
fn tell n ulong k ulong to void
emit cc
emitu n
emit cm
emitu k
emit eqs
emitu binom n k
emit nl
end
fn main to int
tell 5 3
tell 10 0
tell 10 10
tell 33 17
tell 60 30
tell 67 33
ret 0
end
