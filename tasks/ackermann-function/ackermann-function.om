note Rosetta Code task "Ackermann function": https://rosettacode.org/wiki/Ackermann_function
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
om2
text nl "\n"
text pre "A("
text cm ", "
text post ") = "
note emit writes every byte of a to stdout; a short write is retried, an error exits 1
fn emit a view uchar * to void
o = ulong 0
while lt o len a bound 4096
k = write 1 a o sub len a o
if le k 0
exit 1
end
o = add o ulong k
end
end
note emitu writes n in decimal; 20 digits hold every ulong
fn emitu n ulong to void
d = new uchar 20 0
i = ulong 20
v = n
while true bound 20
i = sub i 1
put d i uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
emit part d i sub 20 i
end
note recursive, as the task asks; program mode allows recursion, the 8 MiB stack bounds its depth
fn ack m ulong n ulong to ulong
if eq m 0
ret add n 1
end
if eq n 0
ret ack sub m 1 1
end
ret ack sub m 1 ack m sub n 1
end
fn main to int
for m ulong 4
for n ulong 5
emit pre
emitu m
emit cm
emitu n
emit post
emitu ack m n
emit nl
end
end
ret 0
end
