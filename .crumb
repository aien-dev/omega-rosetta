{
  "schema_version": "1.0.0",
  "name": "omega-rosetta",
  "parent": "aien-dev/omega-mv@e5b32567a7aff3ce594e3254a622a846a6cd190b",
  "purpose": "Rosetta Code tasks and Exercism-style exercises written in Omegese (OM-2) and compiled by the seeded omc pinned in omega.ref; run.sh births omc from the 408-byte seed, compiles and runs every task and compares its stdout byte for byte with an expected.txt written by an independent Python oracle; CI on ubuntu-24.04-arm runs it with negative controls.",
  "layer": "verification",
  "invariants": [
    "expected.txt is written only by the task's oracle.py, never by omc; CI re-runs every oracle and requires byte equality.",
    "run.sh refuses any omc whose sha256 differs from omega.ref.",
    "Every negative control must fail; a workflow where a control passes is broken, not green.",
    "Drafts under drafts/rosettacode are never posted by an agent; posting needs Drake's rosettacode.org account."
  ]
}
