note Exercism-style exercise "binary-search": https://exercism.org/tracks/python/exercises/binary-search
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note find is the index of v in the ascending array a, found by binary search, or -1 when v is not
note in a.
note Check it with: sh exercise.sh exercises/binary-search
om2
fn find a view ulong * v ulong to long
lo = ulong 0
hi = len a
while lt lo hi bound 64
m = add lo div sub hi lo 2
x = get a m
if eq x v
ret long m
end
if lt x v
lo = add m 1
else
hi = m
end
end
ret -1
end
