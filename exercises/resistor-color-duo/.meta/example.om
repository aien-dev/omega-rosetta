note Exercism-style exercise "resistor-color-duo": https://exercism.org/tracks/python/exercises/resistor-color-duo
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note colors holds band color names joined by commas. value is the two-digit number given by the
note first two bands (black 0, brown 1, red 2, orange 3, yellow 4, green 5, blue 6, violet 7, grey 8,
note white 9); further bands are ignored.
note Check it with: sh exercise.sh exercises/resistor-color-duo
om2
text rc0 "black"
text rc1 "brown"
text rc2 "red"
text rc3 "orange"
text rc4 "yellow"
text rc5 "green"
text rc6 "blue"
text rc7 "violet"
text rc8 "grey"
text rc9 "white"
fn same a view uchar * b view uchar * to bool
if ne len a len b
ret false
end
for i ulong len a
if ne get a i get b i
ret false
end
end
ret true
end
fn code color view uchar * to ulong
if same color rc0
ret 0
end
if same color rc1
ret 1
end
if same color rc2
ret 2
end
if same color rc3
ret 3
end
if same color rc4
ret 4
end
if same color rc5
ret 5
end
if same color rc6
ret 6
end
if same color rc7
ret 7
end
if same color rc8
ret 8
end
if same color rc9
ret 9
end
ret 10
end
fn band cs view uchar * n ulong to ulong
s = ulong 0
f = ulong 0
for i ulong add len cs 1
stop = eq i len cs
if not stop
stop = eq get cs i 44
end
if stop
if eq f n
ret code part cs s sub i s
end
f = add f 1
s = add i 1
end
end
ret 10
end
fn value colors view uchar * to ulong
ret add mul band colors 0 10 band colors 1
end
