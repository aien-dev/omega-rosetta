note ---- test harness (appended after the solution by exercise.sh) ----
text tok "ok "
text tnok "not ok "
text tsep " - "
text tnl "\n"
global tfails ulong 1
global tnum ulong 1
fn temit a view uchar * to void
o = ulong 0
while lt o len a bound 4096
k = write 1 a o sub len a o
if le k 0
exit 2
end
o = add o ulong k
end
end
fn temitu n ulong to void
d = new uchar 20 0
i = ulong 20
v = n
while true bound 20
i = sub i 1
put d i uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
temit part d i sub 20 i
end
note one TAP-style line per case; main returns the number of failed cases
fn tcheck c bool what view uchar * to void
put tnum 0 add get tnum 0 1
if c
temit tok
else
temit tnok
put tfails 0 add get tfails 0 1
end
temitu get tnum 0
temit tsep
temit what
temit tnl
end
text c0 "square 1 is 1"
text c1 "square 2 is 2"
text c2 "square 3 is 4"
text c3 "square 4 is 8"
text c4 "square 16 is 32768"
text c5 "square 32 is 2147483648"
text c6 "square 64 is 9223372036854775808"
text c7 "total is 18446744073709551615"
fn main to int
tcheck eq square 1 1 c0
tcheck eq square 2 2 c1
tcheck eq square 3 4 c2
tcheck eq square 4 8 c3
tcheck eq square 16 32768 c4
tcheck eq square 32 2147483648 c5
tcheck eq square 64 9223372036854775808 c6
tcheck eq total 18446744073709551615 c7
ret int get tfails 0
end
