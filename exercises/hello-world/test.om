note ---- test harness (appended after the solution by exercise.sh) ----
text tok "ok "
text tnok "not ok "
text tsep " - "
text tnl "\n"
global tfails ulong 1
global tnum ulong 1
fn temit a view uchar * to void
o = ulong 0
while lt o len a bound 4096
k = write 1 a o sub len a o
if le k 0
exit 2
end
o = add o ulong k
end
end
fn temitu n ulong to void
d = new uchar 20 0
i = ulong 20
v = n
while true bound 20
i = sub i 1
put d i uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
temit part d i sub 20 i
end
note one TAP-style line per case; main returns the number of failed cases
fn tcheck c bool what view uchar * to void
put tnum 0 add get tnum 0 1
if c
temit tok
else
temit tnok
put tfails 0 add get tfails 0 1
end
temitu get tnum 0
temit tsep
temit what
temit tnl
end
note cases: exercism/problem-specifications exercises/hello-world/canonical-data.json at
note commit 650bebeb39ad40439175288042aece982b0a90a9 (2026-10-19), MIT licence,
note https://github.com/exercism/problem-specifications
note 1 cases kept, 0 skipped
fn tbeq a view uchar * b view uchar * to bool
if ne len a len b
ret false
end
for i ulong len a
if ne get a i get b i
ret false
end
end
ret true
end
text e0 "Hello, World!"
text c1 "hello: Say Hi!"
note canonical case af9ffe10-dc13-42d8-a742-e7bdafac449d
fn tc0 to bool
o = new uchar 1024 0
n = hello o
ret tbeq part o 0 n e0
end
fn main to int
tcheck tc0 c1
ret int get tfails 0
end
