note canonical case 7ae7a46a-d992-4c2a-9c15-a112d125ebad
fn tc0 to bool
o = new uchar 1024 0
n = slices s0 1 o
if lt n 0
ret false
end
ret tbeq part o 0 ulong n e1
end
