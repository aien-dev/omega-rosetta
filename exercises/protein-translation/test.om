note canonical case 2c44f7bf-ba20-43f7-a3bf-f2219c0c3f98
fn tc0 to bool
o = new uchar 1024 0
n = proteins part z0 0 0 o
if lt n 0
ret false
end
ret eq ulong n 0
end
