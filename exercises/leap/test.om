note ---- test harness (appended after the solution by exercise.sh) ----
text tok "ok "
text tnok "not ok "
text tsep " - "
text tnl "\n"
global tfails ulong 1
global tnum ulong 1
fn temit a view uchar * to void
o = ulong 0
while lt o len a bound 4096
k = write 1 a o sub len a o
if le k 0
exit 2
end
o = add o ulong k
end
end
fn temitu n ulong to void
d = new uchar 20 0
i = ulong 20
v = n
while true bound 20
i = sub i 1
put d i uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
temit part d i sub 20 i
end
note one TAP-style line per case; main returns the number of failed cases
fn tcheck c bool what view uchar * to void
put tnum 0 add get tnum 0 1
if c
temit tok
else
temit tnok
put tfails 0 add get tfails 0 1
end
temitu get tnum 0
temit tsep
temit what
temit tnl
end
text c0 "2015"
text c1 "1970"
text c2 "1996"
text c3 "1960"
text c4 "2100"
text c5 "1900"
text c6 "2000"
text c7 "2400"
text c8 "1800"
fn main to int
tcheck eq leap 2015 false c0
tcheck eq leap 1970 false c1
tcheck eq leap 1996 true c2
tcheck eq leap 1960 true c3
tcheck eq leap 2100 false c4
tcheck eq leap 1900 false c5
tcheck eq leap 2000 true c6
tcheck eq leap 2400 true c7
tcheck eq leap 1800 false c8
ret int get tfails 0
end
