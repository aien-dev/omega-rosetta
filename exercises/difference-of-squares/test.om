note ---- test harness (appended after the solution by exercise.sh) ----
text tok "ok "
text tnok "not ok "
text tsep " - "
text tnl "\n"
global tfails ulong 1
global tnum ulong 1
fn temit a view uchar * to void
o = ulong 0
while lt o len a bound 4096
k = write 1 a o sub len a o
if le k 0
exit 2
end
o = add o ulong k
end
end
fn temitu n ulong to void
d = new uchar 20 0
i = ulong 20
v = n
while true bound 20
i = sub i 1
put d i uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
temit part d i sub 20 i
end
note one TAP-style line per case; main returns the number of failed cases
fn tcheck c bool what view uchar * to void
put tnum 0 add get tnum 0 1
if c
temit tok
else
temit tnok
put tfails 0 add get tfails 0 1
end
temitu get tnum 0
temit tsep
temit what
temit tnl
end
text c0 "sqsum 1 is 1"
text c1 "sumsq 1 is 1"
text c2 "diffsq 1 is 0"
text c3 "sqsum 5 is 225"
text c4 "sumsq 5 is 55"
text c5 "diffsq 5 is 170"
text c6 "sqsum 100 is 25502500"
text c7 "sumsq 100 is 338350"
text c8 "diffsq 100 is 25164150"
fn main to int
tcheck eq sqsum 1 1 c0
tcheck eq sumsq 1 1 c1
tcheck eq diffsq 1 0 c2
tcheck eq sqsum 5 225 c3
tcheck eq sumsq 5 55 c4
tcheck eq diffsq 5 170 c5
tcheck eq sqsum 100 25502500 c6
tcheck eq sumsq 100 338350 c7
tcheck eq diffsq 100 25164150 c8
ret int get tfails 0
end
