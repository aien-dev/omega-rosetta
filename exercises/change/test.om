note canonical case d0ebd0e1-9d27-4609-a654-df5c0ba1d83a
fn tc0 to bool
a0 = new ulong 4 0
put a0 0 1
put a0 1 5
put a0 2 10
put a0 3 25
o = new ulong 256 0
n = findfewestcoins a0 1 o
if lt n 0
ret false
end
a1 = new ulong 1 0
put a1 0 1
ret tueq part o 0 ulong n a1
end
