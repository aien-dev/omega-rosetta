note Exercism-style exercise "resistor-color": https://exercism.org/tracks/python/exercises/resistor-color
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note The band colors in value order are black brown red orange yellow green blue violet grey white
note (0 .. 9). colorcode is the value of color (10 when it is not a band color); colors writes all
note the band colors in value order, joined by commas, into o and returns the number of bytes written.
note Check it with: sh exercise.sh exercises/resistor-color
om2
text rc0 "black"
text rc1 "brown"
text rc2 "red"
text rc3 "orange"
text rc4 "yellow"
text rc5 "green"
text rc6 "blue"
text rc7 "violet"
text rc8 "grey"
text rc9 "white"
fn same a view uchar * b view uchar * to bool
if ne len a len b
ret false
end
for i ulong len a
if ne get a i get b i
ret false
end
end
ret true
end
fn app o edit uchar * p ulong s view uchar * to ulong
q = p
for i ulong len s
put o q get s i
q = add q 1
end
ret q
end
fn colorcode color view uchar * to ulong
if same color rc0
ret 0
end
if same color rc1
ret 1
end
if same color rc2
ret 2
end
if same color rc3
ret 3
end
if same color rc4
ret 4
end
if same color rc5
ret 5
end
if same color rc6
ret 6
end
if same color rc7
ret 7
end
if same color rc8
ret 8
end
if same color rc9
ret 9
end
ret 10
end
fn colors o edit uchar * to ulong
p = app o 0 rc0
put o p 44
p = app o add p 1 rc1
put o p 44
p = app o add p 1 rc2
put o p 44
p = app o add p 1 rc3
put o p 44
p = app o add p 1 rc4
put o p 44
p = app o add p 1 rc5
put o p 44
p = app o add p 1 rc6
put o p 44
p = app o add p 1 rc7
put o p 44
p = app o add p 1 rc8
put o p 44
p = app o add p 1 rc9
ret p
end
