note 5 cases kept, 0 skipped
text c0 "prime: first prime"
text c1 "prime: second prime"
text c2 "prime: sixth prime"
text c3 "prime: big prime"
text c4 "prime: there is no zeroth prime"
note canonical case 75c65189-8aef-471a-81de-0a90c728160c
fn tc0 to bool
ret eq prime 1 2
end
