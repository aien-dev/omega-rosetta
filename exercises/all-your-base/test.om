note canonical case 5ce422f9-7a4b-4f44-ad29-49c67cb32d2c
fn tc0 to bool
a0 = new long 1 0
put a0 0 1
o = new long 256 0
n = rebase 2 a0 10 o
if lt n 0
ret false
end
a1 = new long 1 0
put a1 0 1
ret tleq part o 0 ulong n a1
end
