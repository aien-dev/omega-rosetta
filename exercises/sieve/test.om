note ---- test harness (appended after the solution by exercise.sh) ----
text tok "ok "
text tnok "not ok "
text tsep " - "
text tnl "\n"
global tfails ulong 1
global tnum ulong 1
fn temit a view uchar * to void
o = ulong 0
while lt o len a bound 4096
k = write 1 a o sub len a o
if le k 0
exit 2
end
o = add o ulong k
end
end
fn temitu n ulong to void
d = new uchar 20 0
i = ulong 20
v = n
while true bound 20
i = sub i 1
put d i uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
temit part d i sub 20 i
end
note one TAP-style line per case; main returns the number of failed cases
fn tcheck c bool what view uchar * to void
put tnum 0 add get tnum 0 1
if c
temit tok
else
temit tnok
put tfails 0 add get tfails 0 1
end
temitu get tnum 0
temit tsep
temit what
temit tnl
end
note cases: exercism/problem-specifications exercises/sieve/canonical-data.json at
note commit 650bebeb39ad40439175288042aece982b0a90a9 (2026-10-19), MIT licence,
note https://github.com/exercism/problem-specifications
note 5 cases kept, 0 skipped
fn tueq a view ulong * b view ulong * to bool
if ne len a len b
ret false
end
for i ulong len a
if ne get a i get b i
ret false
end
end
ret true
end
text c0 "primes: no primes under two"
text c1 "primes: find first prime"
text c2 "primes: find primes up to 10"
text c3 "primes: limit is prime"
text c4 "primes: find primes up to 1000"
note canonical case 88529125-c4ce-43cc-bb36-1eb4ddd7b44f
fn tc0 to bool
o = new ulong 256 0
n = primes 1 o
ret eq n 0
end
note canonical case 4afe9474-c705-4477-9923-840e1024cc2b
fn tc1 to bool
o = new ulong 256 0
n = primes 2 o
a0 = new ulong 1 0
put a0 0 2
ret tueq part o 0 n a0
end
