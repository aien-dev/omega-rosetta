note Exercism-style exercise "secret-handshake": https://exercism.org/tracks/python/exercises/secret-handshake
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note commands writes the handshake of the low five bits of n into o, joined by commas: 1 wink,
note 2 double blink, 4 close your eyes, 8 jump, in that order, reversed when bit 16 is set; returns
note the number of bytes written.
note Check it with: sh exercise.sh exercises/secret-handshake
om2
text hs0 "wink"
text hs1 "double blink"
text hs2 "close your eyes"
text hs3 "jump"
fn app o edit uchar * p ulong s view uchar * to ulong
q = p
for i ulong len s
put o q get s i
q = add q 1
end
ret q
end
fn appcmd o edit uchar * p ulong k ulong to ulong
if eq k 0
ret app o p hs0
end
if eq k 1
ret app o p hs1
end
if eq k 2
ret app o p hs2
end
ret app o p hs3
end
fn commands n ulong o edit uchar * to ulong
p = ulong 0
rev = ne and n 16 0
for i ulong 4
k = i
if rev
k = sub 3 i
end
if ne and shr n k 1 0
if gt p 0
put o p 44
p = add p 1
end
p = appcmd o p k
end
end
ret p
end
