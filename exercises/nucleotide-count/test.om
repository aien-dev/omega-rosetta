note canonical case b4c47851-ee9e-4b0a-be70-a86e343bd851
fn tc4 to bool
o = new ulong 4 0
ret not nucleotidecounts s8 o
end
fn main to int
tcheck tc0 c1
tcheck tc1 c3
tcheck tc2 c5
tcheck tc3 c7
tcheck tc4 c9
ret int get tfails 0
end
