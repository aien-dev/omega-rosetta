note ---- test harness (appended after the solution by exercise.sh) ----
text tok "ok "
text tnok "not ok "
text tsep " - "
text tnl "\n"
global tfails ulong 1
global tnum ulong 1
fn temit a view uchar * to void
o = ulong 0
while lt o len a bound 4096
k = write 1 a o sub len a o
if le k 0
exit 2
end
o = add o ulong k
end
end
fn temitu n ulong to void
d = new uchar 20 0
i = ulong 20
v = n
while true bound 20
i = sub i 1
put d i uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
temit part d i sub 20 i
end
note one TAP-style line per case; main returns the number of failed cases
fn tcheck c bool what view uchar * to void
put tnum 0 add get tnum 0 1
if c
temit tok
else
temit tnok
put tfails 0 add get tfails 0 1
end
temitu get tnum 0
temit tsep
temit what
temit tnl
end
note cases: exercism/problem-specifications exercises/saddle-points/canonical-data.json at
note commit 650bebeb39ad40439175288042aece982b0a90a9 (2026-10-19), MIT licence,
note https://github.com/exercism/problem-specifications
note 9 cases kept, 0 skipped
fn tueq a view ulong * b view ulong * to bool
if ne len a len b
ret false
end
for i ulong len a
if ne get a i get b i
ret false
end
end
ret true
end
text c0 "saddlePoints: Can identify single saddle point"
text c1 "saddlePoints: Can identify that empty matrix has no saddle points"
text c2 "saddlePoints: Can identify lack of saddle points when there are none"
text c3 "saddlePoints: Can identify multiple saddle points in a column"
text c4 "saddlePoints: Can identify multiple saddle points in a row"
text c5 "saddlePoints: Can identify saddle point in bottom right corner"
text c6 "saddlePoints: Can identify saddle points in a non square matrix"
text c7 "saddlePoints: Can identify that saddle points in a single column matrix are those with the minimum value"
text c8 "saddlePoints: Can identify that saddle points in a single row matrix are those with the maximum value"
note canonical case 3e374e63-a2e0-4530-a39a-d53c560382bd
fn tc0 to bool
a0 = new ulong 9 0
put a0 0 9
put a0 1 8
put a0 2 7
put a0 3 5
put a0 4 3
put a0 5 2
put a0 6 6
put a0 7 6
put a0 8 7
o = new ulong 256 0
n = saddlepoints a0 3 3 o
a1 = new ulong 2 0
put a1 0 2
put a1 1 1
ret tueq part o 0 mul n 2 a1
end
